# דוגמה להגדרות — להעתיק ל-.env.local ולמלא. אין לשים כאן ערכים אמיתיים.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# המפתח הסודי — רק בשרת ובסקריפט ההעלאה. לעולם לא בצ'אט, לא ב-git ולא עם הקידומת NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# מי מנהלת: מיילים מופרדים בפסיק — רק הן נכנסות ל-/admin. ריק = אף אחת
ADMIN_EMAILS=

# מאיפה מגיעים הסרטונים והמטלות: local (תיקיות במחשב, ברירת מחדל), supabase או r2 (אחסון פרטי)
# MEDIA_SOURCE=supabase

# Cloudflare R2 (כש-MEDIA_SOURCE=r2). המפתחות — רק בשרת. העתקה: scripts/copy-to-r2.mjs
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=course-media

# אופציונלי — ראו CLAUDE.md סעיף 9
# CONTENT_DIR=content-source
# PROCESSED_DIR=content-processed
# REQUIRE_APP=1
# DEV_SKIP_ACCESS=1   (רק במחשב, ב-npm run dev)
